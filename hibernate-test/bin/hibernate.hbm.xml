<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD 3.0//EN" "http://www.hibernate.org/dtd/hibernate-mapping-3.0.dtd" >
<hibernate-mapping>
	<class name="com.nobelit.hibernate.model.Book" table="book">
		<id name="bookId" column="id" type="java.lang.Integer">
			<generator class="increment"></generator>
		</id>
		<property name="bookName" column="name" type="java.lang.String"></property>
		<property name="authorName" column="authorName" type="java.lang.String"></property>
		<property name="publishedDate" column="published" type="java.sql.Date"></property>
		<property name="bookPrice" column="price" type="java.lang.Integer"></property>
	</class>
</hibernate-mapping>